# Production settings, read by docker compose (see docker-compose.yml).
# Copy to .env on the server and fill in — never commit the result.

# Required. Generate with: openssl rand -hex 32
INVOICE_SECRET_KEY=change-me-in-production

# SQLite file inside the container; the directory below is mounted onto /data.
INVOICE_DATABASE_URL=sqlite+aiosqlite:////data/invoice.db

# Host directory holding the database — outside the repository, so that the
# deployment hook's `git checkout -f` can never touch it.
INVOICE_DATA_DIR=/home/johnny/data/invoice

# JWT lifetimes
INVOICE_ACCESS_TOKEN_EXPIRE_MINUTES=30
INVOICE_REFRESH_TOKEN_EXPIRE_DAYS=7
